  m_Script: {fileID: 11500000, guid: 7e2fc63825895e8429f9d28a3a6515a6, type: 3}
  m_Name: UselessDialogue10
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  conversationId: useless_dialogue_10
  displayName: Useless Dialogue 10
  lines:
  - character: {fileID: 11400000, guid: c052724c165f89a43a01ab84f981b02c, type: 2}
    portraitExpression: 16
    localizedTexts:
    - languageCode: en
      text: I keep meaning to take a walk, but then I remember I am already standing somewhere.
  - character: {fileID: 11400000, guid: c052724c165f89a43a01ab84f981b02c, type: 2}
    portraitExpression: 17
    localizedTexts:
    - languageCode: en
      text: It feels wasteful to abandon a perfectly good location.
  - character: {fileID: 11400000, guid: c052724c165f89a43a01ab84f981b02c, type: 2}
    portraitExpression: 21
    localizedTexts:
    - languageCode: en
      text: Maybe tomorrow I will stand somewhere else for variety.
  - character: {fileID: 11400000, guid: c052724c165f89a43a01ab84f981b02c, type: 2}
    portraitExpression: 22
    localizedTexts:
    - languageCode: en
      text: That should keep life exciting.
  dialogueChoice: {fileID: 0}
