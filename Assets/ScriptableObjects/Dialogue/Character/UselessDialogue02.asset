  conversationId: useless_dialogue_02
  displayName: Useless Dialogue 02
  lines:
  - character: {fileID: 11400000, guid: c052724c165f89a43a01ab84f981b02c, type: 2}
    portraitExpression: 16
    localizedTexts:
    - languageCode: en
      text: Have you ever noticed that stairs are just ladders pretending to be polite?
  - character: {fileID: 11400000, guid: c052724c165f89a43a01ab84f981b02c, type: 2}
    portraitExpression: 22
    localizedTexts:
    - languageCode: en
      text: I do not trust them, but I respect the effort.
  - character: {fileID: 11400000, guid: c052724c165f89a43a01ab84f981b02c, type: 2}
    portraitExpression: 21
    localizedTexts:
    - languageCode: en
      text: Best not to tell the stairs I said that.
  dialogueChoice: {fileID: 0}
