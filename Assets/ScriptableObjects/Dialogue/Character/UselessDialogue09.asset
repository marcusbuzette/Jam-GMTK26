  conversationId: useless_dialogue_09
  displayName: Useless Dialogue 09
  lines:
  - character: {fileID: 11400000, guid: c052724c165f89a43a01ab84f981b02c, type: 2}
    portraitExpression: 22
    localizedTexts:
    - languageCode: en
      text: A leaf landed on my shoulder, and for a moment I thought I had been promoted.
  - character: {fileID: 11400000, guid: c052724c165f89a43a01ab84f981b02c, type: 2}
    portraitExpression: 16
    localizedTexts:
    - languageCode: en
      text: Then the wind reclaimed it without explanation.
  - character: {fileID: 11400000, guid: c052724c165f89a43a01ab84f981b02c, type: 2}
    portraitExpression: 20
    localizedTexts:
    - languageCode: en
      text: Leadership is fleeting, it seems.
  dialogueChoice: {fileID: 0}
