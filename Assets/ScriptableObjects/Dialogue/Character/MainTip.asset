  - character: {fileID: 11400000, guid: 434505ccd8a2eaa4f9a25d48cf8701b0, type: 2}
    portraitExpression: 16
    localizedTexts:
    - languageCode: en
      text: There is a bomb in ths party! Have you seen a silver suitcase?
  - character: {fileID: 11400000, guid: c052724c165f89a43a01ab84f981b02c, type: 2}
    portraitExpression: 18
    localizedTexts:
    - languageCode: en
      text: Oh my god!
  - character: {fileID: 11400000, guid: c052724c165f89a43a01ab84f981b02c, type: 2}
    portraitExpression: 22
    localizedTexts:
    - languageCode: en
      text: I think I saw a silver suitcase in the kitchen!
  - character: {fileID: 11400000, guid: 434505ccd8a2eaa4f9a25d48cf8701b0, type: 2}
    portraitExpression: 19
    localizedTexts:
    - languageCode: en
      text: Thanks! I'll take a look.
