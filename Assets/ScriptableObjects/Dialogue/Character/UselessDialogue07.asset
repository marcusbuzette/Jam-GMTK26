  lines:
  - character: {fileID: 11400000, guid: c052724c165f89a43a01ab84f981b02c, type: 2}
    portraitExpression: 17
    localizedTexts:
    - languageCode: en
      text: My left shoe feels optimistic today.
  - character: {fileID: 11400000, guid: c052724c165f89a43a01ab84f981b02c, type: 2}
    portraitExpression: 20
    localizedTexts:
    - languageCode: en
      text: The right one remains doubtful, as usual.
  - character: {fileID: 11400000, guid: c052724c165f89a43a01ab84f981b02c, type: 2}
    portraitExpression: 22
    localizedTexts:
    - languageCode: en
      text: Together they form a balanced philosophy.
  dialogueChoice: {fileID: 0}
