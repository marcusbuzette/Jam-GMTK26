  displayName: Useless Dialogue 03
  lines:
  - character: {fileID: 11400000, guid: c052724c165f89a43a01ab84f981b02c, type: 2}
    portraitExpression: 17
    localizedTexts:
    - languageCode: en
      text: I once waved at a window because I thought it was a person.
  - character: {fileID: 11400000, guid: c052724c165f89a43a01ab84f981b02c, type: 2}
    portraitExpression: 18
    localizedTexts:
    - languageCode: en
      text: The window looked surprised, which only made things worse.
  - character: {fileID: 11400000, guid: c052724c165f89a43a01ab84f981b02c, type: 2}
    portraitExpression: 22
    localizedTexts:
    - languageCode: en
      text: We have not spoken since.
  dialogueChoice: {fileID: 0}
