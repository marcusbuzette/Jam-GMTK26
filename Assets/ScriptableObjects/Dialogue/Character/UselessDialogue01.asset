  m_Script: {fileID: 11500000, guid: 7e2fc63825895e8429f9d28a3a6515a6, type: 3}
  m_Name: UselessDialogue01
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  conversationId: useless_dialogue_01
  displayName: Useless Dialogue 01
  lines:
  - character: {fileID: 11400000, guid: c052724c165f89a43a01ab84f981b02c, type: 2}
    portraitExpression: 22
    localizedTexts:
    - languageCode: en
      text: I spent all morning deciding whether this pebble looks more round or more tired.
  - character: {fileID: 11400000, guid: c052724c165f89a43a01ab84f981b02c, type: 2}
    portraitExpression: 16
    localizedTexts:
    - languageCode: en
      text: It has not helped that it refuses to answer simple questions.
  - character: {fileID: 11400000, guid: c052724c165f89a43a01ab84f981b02c, type: 2}
    portraitExpression: 17
    localizedTexts:
    - languageCode: en
      text: Still, I admire its commitment to mystery.
  dialogueChoice: {fileID: 0}
