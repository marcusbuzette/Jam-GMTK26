  displayName: Useless Dialogue 05
  lines:
  - character: {fileID: 11400000, guid: c052724c165f89a43a01ab84f981b02c, type: 2}
    portraitExpression: 22
    localizedTexts:
    - languageCode: en
      text: I heard a crate creak, and now I am convinced it was trying to gossip.
  - character: {fileID: 11400000, guid: c052724c165f89a43a01ab84f981b02c, type: 2}
    portraitExpression: 16
    localizedTexts:
    - languageCode: en
      text: I stayed nearby in case it had anything important to add.
  - character: {fileID: 11400000, guid: c052724c165f89a43a01ab84f981b02c, type: 2}
    portraitExpression: 17
    localizedTexts:
    - languageCode: en
      text: It did not, but the suspense was excellent.
  dialogueChoice: {fileID: 0}
